# Copy to .env locally if you use a dotenv loader.
# Spring Boot reads OS environment variables / IDE run configs, not .env by default.
# Never commit real secrets. These values are for local development only.

JWT_SECRET=ridelink-dev-only-change-me-please-32chars-min
JWT_EXPIRATION_MS=86400000

ACCOUNT_SERVER_PORT=8081
DRIVER_SERVER_PORT=8082
RIDE_SERVER_PORT=8083
FARE_SERVER_PORT=8084

DRIVER_SERVICE_URL=http://localhost:8082
FARE_SERVICE_URL=http://localhost:8084
ACCOUNT_SERVICE_URL=http://localhost:8081

# Optional later: Postgres (not required for local H2)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ridelink_account
# SPRING_DATASOURCE_USERNAME=ridelink
# SPRING_DATASOURCE_PASSWORD=change-me
